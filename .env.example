# Required.
DATABASE_URL="postgres://booking:booking@localhost:5432/booking"
# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-characters!!"

# Used in links sent to customers.
APP_URL="http://localhost:3000"

# Must be "postgres" in production: an in-memory bucket is per instance, so it
# does not bound a public endpoint.
RATE_LIMIT_BACKEND="postgres"

# How long a booking awaiting payment keeps its slot.
BOOKING_HOLD_MINUTES="30"

# Deposits. Without these a service that requires payment cannot be paid for.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# SMS reminders. All three or none; without them the worker logs the messages
# it would have sent.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+15555550123"

LOG_LEVEL="info"

# Only for tests: the server a throwaway test database is created on. The
# database-backed suites skip without it.
# TEST_DATABASE_URL="postgres://booking:booking@localhost:5432/postgres"
